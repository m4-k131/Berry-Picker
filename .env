#DO NOT TRACK THIS FILE WITH GIT! 
#DO NOT REMOVE THIS FILE FROM .gitignore!

# --- SSH Access ---
# Paste the PUBLIC key(s) you want to grant SSH access to this Raspberry Pi.
# You can add multiple keys, each on a new line, inside the quotes.
# Example: AUTHORIZED_SSH_KEYS="ssh-rsa AAA... user@machine1
# ssh-rsa BBB... user@machine2"
AUTHORIZED_SSH_KEYS=""

# --- Surfshark OpenVPN Credentials ---
# These are required if you plan to run the setup_surfshark_openvpn.sh script.
SURFSHARK_USERNAME="ENTER_YOUR_USERNAME_HERE"
SURFSHARK_PASSWORD="ENTER_YOUR_PASSWORD_HERE"
